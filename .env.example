# Мир Самозанятых v8.7.0 — Environment Variables

# Security
SECRET_KEY=your-super-secret-key-here-min-32-chars

# Database
DATABASE_URL=sqlite:///./mir_samozanyatykh.db

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@mir-samozanyatykh.ru

# External APIs
OPENROUTER_API_KEY=your-openrouter-key
OPENAI_API_KEY=

# Agent provider models are intentionally explicit; do not guess model IDs.
AGENT_PROVIDER_ORDER=openrouter,openai,ollama
AGENT_OPENROUTER_MODEL=
AGENT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_HTTP_REFERER=
AGENT_OPENAI_MODEL=
AGENT_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local OpenAI-compatible fallback (for example, Ollama).
AGENT_OLLAMA_BASE_URL=
AGENT_OLLAMA_MODEL=
AGENT_OLLAMA_API_KEY=ollama

# Real runtime verification target.
AGENT_RUNTIME_BASE_URL=
AGENT_RUNTIME_TIMEOUT=10
AGENT_RUN_TESTS=true
AGENT_TEST_TIMEOUT=120

# Payments / SMS
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
SMSRU_API_ID=your-smsru-api-id

# FNS API
FNS_API_URL=https://npd.nalog.ru/api
