# ================================
# Мир Самозанятых v4.2 — переменные окружения
# ================================

# Безопасность (ОБЯЗАТЕЛЬНО сгенерировать новый ключ!)
# Генерация: openssl rand -hex 64
SECRET_KEY=your-super-secret-key-here-min-64-chars-long-change-in-production

# Режим: development | production
ENVIRONMENT=development

# База данных (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/mir_samozanyatykh.db

# Redis (опционально, для rate limiting и кэша)
REDIS_URL=redis://redis:6379/0

# Email (SMTP для подтверждения email)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=it-laboratory@bk.ru
SMTP_PASSWORD=your_smtp_password_here
SMTP_TLS=true

# AI / OpenRouter (для Светланы)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# FNS API (проверка ИНН)
FNS_API_URL=https://api-fns.ru/api/
FNS_API_KEY=your-fns-api-key

# Электронная подпись (CryptoPro)
CRYPTOPRO_ENABLED=false

# Telegram Bot (уведомления)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain/api/telegram/webhook

# Домен
DOMAIN=мир-самозанятых.рф

# JWT настройки
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# Загрузка файлов
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# Логирование
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
