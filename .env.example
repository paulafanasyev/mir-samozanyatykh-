# ================================
# Мир Самозанятых v7.0 — переменные окружения
# ================================

# Безопасность (ОБЯЗАТЕЛЬНО сгенерировать новый ключ!)
# Генерация: openssl rand -hex 64
SECRET_KEY=your-super-secret-key-here-min-64-chars-long-change-in-production

# Режим: development | production
ENVIRONMENT=development

# База данных (PostgreSQL рекомендуется для production)
DATABASE_URL=postgresql+asyncpg://mir_user:change_me_in_production@postgres:5432/mir_samozanyatykh
# Для локальной разработки:
# DATABASE_URL=sqlite+aiosqlite:///./data/mir_samozanyatykh.db
POSTGRES_PASSWORD=change_me_in_production

# Redis (для Celery, кэша, WebSocket)
REDIS_URL=redis://redis:6379/0

# Email (SMTP)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=it-laboratory@bk.ru
SMTP_PASSWORD=your_smtp_password_here

# AI / OpenRouter (для Светланы)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# FNS API (проверка ИНН)
FNS_API_URL=https://api-fns.ru/api/
FNS_API_KEY=your-fns-api-key

# ЦБ РФ API (курсы валют)
CBR_API_URL=https://www.cbr.ru/scripts/XML_daily.asp

# Электронная подпись
CRYPTOPRO_ENABLED=false

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain/api/telegram/webhook

# SMS.ru
SMS_RU_API_KEY=your-sms-ru-api-key

# YooKassa (платежи)
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# Домен
DOMAIN=мир-самозанятых.рф

# JWT настройки
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# Загрузка файлов
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# Логирование
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# OAuth (социальный вход)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
TELEGRAM_OAUTH_BOT=your-telegram-oauth-bot
