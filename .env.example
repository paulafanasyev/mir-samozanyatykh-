# Мир Самозанятых — Environment Configuration
# Скопируйте в .env и заполните реальными значениями

# === Application ===
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-min-64-chars-hex-recommended

# === Database ===
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./mir_samozanyatykh.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mir_samozanyatykh

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === AI (OpenRouter) ===
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Payments (YooKassa) ===
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxx

# === Email (SMTP) ===
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=it-laboratory@bk.ru
SMTP_PASSWORD=your-email-password
SMTP_FROM=Мир Самозанятых <it-laboratory@bk.ru>

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# === FNS API ===
FNS_API_KEY=your-fns-api-key

# === Bank APIs ===
TINKOFF_API_KEY=your-tinkoff-key
SBER_API_KEY=your-sber-key

# === Monitoring ===
GRAFANA_PASSWORD=admin
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# === Domain ===
DOMAIN=mir-samozanyatykh.ru
API_URL=https://api.mir-samozanyatykh.ru
FRONTEND_URL=https://mir-samozanyatykh.ru

# === Security ===
CORS_ORIGINS=https://mir-samozanyatykh.ru,https://app.mir-samozanyatykh.ru
RATE_LIMIT_PER_MINUTE=100
