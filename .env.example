# ============================================
# Мир Самозанятых v6.0 — Пример конфигурации
# АНО ЦПС ИНН 9724016805
# ============================================

# === Основные ===
APP_NAME=Мир Самозанятых
APP_VERSION=6.0.0
ENVIRONMENT=production
DEBUG=false

# === Безопасность (ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ!) ===
# Генерация: openssl rand -hex 64
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64-to-generate

# === База данных ===
DB_USER=mir_user
DB_PASSWORD=change_me_strong_password_123
DB_NAME=mir_samozanyatykh
DATABASE_URL=postgresql+asyncpg://mir_user:change_me_strong_password_123@db:5432/mir_samozanyatykh

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Email (SMTP SSL) ===
# Рекомендуется Yandex или Mail.ru для российских доменов
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-email@yandex.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Мир Самозанятых
SMTP_TLS=true

# === Домен ===
DOMAIN=mir-samozanyatykh.ru
FRONTEND_URL=https://mir-samozanyatykh.ru

# === ЮKassa (онлайн-оплата) ===
# https://yookassa.ru/developers/
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_RETURN_URL=https://mir-samozanyatykh.ru/payment/success
YOOKASSA_CANCEL_URL=https://mir-samozanyatykh.ru/payment/cancel

# === OpenRouter (AI + CosyVoice) ===
# https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_MODEL_DEFAULT=anthropic/claude-3.5-sonnet
OPENROUTER_MODEL_CHEAP=openai/gpt-4o-mini

# === CosyVoice 3.0 (голосовой ассистент) ===
COSYVOICE_API_KEY=${OPENROUTER_API_KEY}
COSYVOICE_API_URL=https://api.openrouter.ai/v1/audio/speech
COSYVOICE_MODEL=cosyvoice-v1
COSYVOICE_VOICE=svetlana

# === ФНС API ===
# https://api-fns.ru/
FNS_API_URL=https://api-fns.ru/api/
FNS_API_KEY=your-fns-api-key

# === SMS.ru ===
# https://sms.ru/
SMS_RU_API_KEY=your-sms-api-key
SMS_RU_SENDER=MirSamoz

# === OAuth (опционально) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# === Telegram бот (опционально) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://mir-samozanyatykh.ru/api/telegram/webhook

# === Traefik ===
ACME_EMAIL=admin@mir-samozanyatykh.ru
# Генерация хеша: htpasswd -nb admin your-password | sed -e s/\$/\$\$/g
TRAEFIK_AUTH=admin:$$apr1$$H6uskkkW$$IgXLP6ewTrSuBkTrqE8wj/

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# === Логирование ===
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
