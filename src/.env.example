# .env.example — Мир Самозанятых v8.4
# АНО ЦПС ИНН 9724016805
# Copy to .env and fill in your values. Never commit real secrets.

# === CORE ===
SECRET_KEY=<generate-with-openssl-rand-hex-64>
BANK_ENCRYPTION_KEY=<generate-with-python-or-openssl-fernet-compatible-32-byte-base64>
ENVIRONMENT=production
DEBUG=false

# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# === REDIS ===
REDIS_URL=redis://host:6379/0

# === DOMAIN ===
DOMAIN=mirsamozanyatykh-api.onrender.com
FRONTEND_URL=https://mirsamozanyatykh.onrender.com

# === EMAIL ===
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=it-laboratory@bk.ru
SMTP_PASSWORD=your-email-password
SMTP_FROM_NAME=Мир Самозанятых

# === AI / secure multi-provider router ===
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL_DEFAULT=anthropic/claude-3.5-sonnet
OPENROUTER_MODEL_CHEAP=openai/gpt-4o-mini
BAI_API_KEY=your-bai-key
# name|key-env|OpenAI-compatible-base-url|model ; ordered fallback list
AI_ROUTES=openrouter|OPENROUTER_API_KEY|https://openrouter.ai/api/v1|${OPENROUTER_MODEL_DEFAULT},bai|BAI_API_KEY|https://example.invalid/v1|your-model

# === YooKassa Payments ===
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_RETURN_URL=https://mirsamozanyatykh.onrender.com/payment/success
YOOKASSA_CANCEL_URL=https://mirsamozanyatykh.onrender.com/payment/cancel

# === FNS API ===
FNS_API_KEY=your-fns-api-key
SMS_RU_API_KEY=your-smsru-key
SMS_RU_SENDER=MirSamoz
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_URL=https://mirsamozanyatykh-api.onrender.com/api/telegram/webhook

# === OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# === WebRTC / voice ===
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
COSYVOICE_API_KEY=

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# === Uploads ===
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/app/uploads

POSTGRES_USER=mir_app
POSTGRES_PASSWORD=<generate-long-random-secret>
POSTGRES_DB=mir_samozanyatykh
REDIS_PASSWORD=<generate-long-random-secret>
